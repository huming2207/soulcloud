// Reference-only Prisma-style representation of Soulcloud's current PostgreSQL
// schema. The Diesel migrations in ../migrations remain the source of truth.
// This file is not used to generate migrations or application code.
// Diesel's __diesel_schema_migrations bookkeeping table is intentionally
// omitted; all application-owned tables in the public schema are represented.
//
// Prisma Schema Language cannot represent the PostgreSQL CHECK constraints in
// this schema. Their exact names and expressions are recorded beside the fields
// they protect so they are not lost during review.

datasource db {
  provider = "postgresql"
}

model User {
  id String @id(map: "users_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// PostgreSQL CHECK users_username_not_blank: btrim(username) <> ''
  username String @unique(map: "users_username_key") @db.VarChar(64)

  /// PostgreSQL CHECK users_password_hash_not_blank: btrim(password_hash) <> ''
  passwordHash String @map("password_hash") @db.Text

  /// PostgreSQL CHECK users_email_not_blank: btrim(email) <> ''
  email String @unique(map: "users_email_key") @db.VarChar(254)

  organisationMemberships OrganisationUser[]

  @@map("users")
}

model Organisation {
  id String @id(map: "organisations_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// PostgreSQL CHECK organisations_name_not_blank: btrim(name) <> ''
  name String @db.VarChar(255)

  /// PostgreSQL CHECK organisations_website_url_not_blank: btrim(website_url) <> ''
  websiteUrl String @map("website_url") @db.Text

  userMemberships    OrganisationUser[]
  projectMemberships OrganisationProject[]

  @@map("organisations")
}

model Project {
  id String @id(map: "projects_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// PostgreSQL CHECK projects_name_not_blank: btrim(name) <> ''
  name String @db.VarChar(255)

  organisationMemberships OrganisationProject[]
  devices                   Device[]

  @@map("projects")
}

model Device {
  id String @id(map: "devices_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Hardware-reported identifier; globally unique.
  /// PostgreSQL CHECK devices_device_uid_not_blank: btrim(device_uid) <> ''
  deviceUid String @unique(map: "devices_device_uid_key") @map("device_uid") @db.VarChar(128)

  /// Human-assigned identifier; unique only within one project.
  /// PostgreSQL CHECK devices_assigned_id_not_blank: btrim(assigned_id) <> ''
  assignedId String @map("assigned_id") @db.VarChar(128)

  /// PostgreSQL CHECK devices_password_hash_not_blank: btrim(password_hash) <> ''
  passwordHash String @map("password_hash") @db.Text

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "devices_project_id_fkey")

  @@unique([projectId, assignedId], map: "devices_project_assigned_id_unique")
  @@map("devices")
}

// Explicit join model for the many-to-many user/organisation relationship.
model OrganisationUser {
  organisationId String       @map("organisation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "organisation_users_organisation_id_fkey")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "organisation_users_user_id_fkey")

  @@id([organisationId, userId], map: "organisation_users_pkey")
  @@index([userId], map: "organisation_users_user_id_idx")
  @@map("organisation_users")
}

// Explicit join model for the many-to-many organisation/project relationship.
model OrganisationProject {
  organisationId String       @map("organisation_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "organisation_projects_organisation_id_fkey")
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "organisation_projects_project_id_fkey")

  @@id([organisationId, projectId], map: "organisation_projects_pkey")
  @@index([projectId], map: "organisation_projects_project_id_idx")
  @@map("organisation_projects")
}
