# Which roles this process runs (comma separated): api, ingest, sweeper
SOULCLOUD_ROLES=api,ingest,sweeper
LOG_LEVEL=info

# PostgreSQL (docker compose maps it to 5433 so it does not clash with a local one)
DATABASE_URL="postgresql://soulcloud:soulcloud@127.0.0.1:5433/soulcloud"

# RabbitMQ service account: AMQP 1.0 for messaging, management HTTP API for
# closing revoked device connections.
AMQP_HOST=127.0.0.1
AMQP_PORT=5672
AMQP_USER=soulcloud
AMQP_PASSWORD=soulcloud
AMQP_VHOST=soulcloud
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672

# Public REST API. TLS is terminated by the reverse proxy (Traefik).
API_HOST=0.0.0.0
API_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# MQTT 5 over WebSocket URL handed to devices at enrollment (wss:// behind Traefik).
DEVICE_MQTT_URL=ws://localhost:15675/ws

# Internal listener for rabbitmq_auth_backend_http. Must be reachable from the
# broker only. The secret must match the path in deploy/rabbitmq/rabbitmq.conf.
BROKER_AUTH_HOST=0.0.0.0
BROKER_AUTH_PORT=8081
BROKER_AUTH_SECRET=dev-broker-secret

# Secrets: generate each with `openssl rand -base64 32`
DEVICE_PASSWORD_PEPPER=change-me-device-pepper-at-least-32-chars
DOWNLOAD_SIGNING_SECRET=change-me-download-signing-secret-32-chars

# Firmware and ELF blob storage
DATA_DIR=./data

# Human accounts: the first registered user becomes admin.
ALLOW_REGISTRATION=true
SESSION_TTL_HOURS=720

# Retention
LOG_RETENTION_DAYS=30
HEARTBEAT_RETENTION_DAYS=30
