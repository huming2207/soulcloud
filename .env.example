# Shared PostgreSQL database
DATABASE_URL=postgres://soulcloud:soulcloud@127.0.0.1:5432/soulcloud

# API server
API_BIND_ADDRESS=0.0.0.0:8080

# Worker: the URL must include the broker's MQTT WebSocket path.
MQTT_BROKER_URL=wss://mqtt.example.com:443/mqtt
MQTT_CLIENT_ID=soulcloud-worker-local
MQTT_KEEP_ALIVE_SECONDS=30
COMMAND_POLL_INTERVAL_MS=500
COMMAND_LEASE_SECONDS=60

# Required until the retained-command contract is finalized. False is the safe
# development choice because a reconnecting device must not receive a stale command.
MQTT_COMMAND_RETAIN=false

# Credentials for the manually provisioned MQTT broker service account.
# Set both or neither.
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Optional HTTP CONNECT proxy. Basic credentials may be embedded in the URL.
# HTTP_PROXY_URL=http://username:password@proxy.example.com:8080

# Logging
RUST_LOG=info
