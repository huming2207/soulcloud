# Postgres (docker compose maps it to 5433 so it does not clash with a local one)
DATABASE_URL="postgresql://soulcloud:soulcloud@127.0.0.1:5433/soulcloud"

# RabbitMQ, AMQP 1.0 (used by the API and worker, not by devices)
AMQP_HOST=127.0.0.1
AMQP_PORT=5672
AMQP_USER=soulcloud
AMQP_PASSWORD=soulcloud
AMQP_VHOST=soulcloud

# HTTP API
API_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Secrets: generate each with `openssl rand -base64 32`
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
DEVICE_PASSWORD_PEPPER=change-me-device-pepper-at-least-32
BROKER_WEBHOOK_TOKEN=change-me-broker-webhook-token
PROVISIONING_API_KEY=change-me-provisioning-api-key
