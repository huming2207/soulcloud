# Production settings for compose.prod.yaml. Copy to .env.production (git-ignored)
# and fill in every value:
#   docker compose -f compose.prod.yaml --env-file .env.production up -d --build

# Public domain; its DNS A/AAAA record must point at this server (ports 80 and 443 open).
DOMAIN=iot.example.com
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=ops@example.com
# Use the staging CA while testing to avoid Let's Encrypt rate limits:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Secrets: generate each with `openssl rand -hex 32` (hex keeps URLs and configs simple).
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
BROKER_AUTH_SECRET=
# Changing the pepper invalidates every device password.
DEVICE_PASSWORD_PEPPER=
DOWNLOAD_SIGNING_SECRET=

# The first account can always be created and becomes admin; further sign-ups
# need this set to true.
ALLOW_REGISTRATION=false

LOG_LEVEL=info
LOG_RETENTION_DAYS=30
HEARTBEAT_RETENTION_DAYS=30

# Image names when building here or pulling from a registry.
IMAGE_PREFIX=soulcloud
IMAGE_TAG=latest
